{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-memory.invalid/evaluation/embedding/report.schema.json",
  "title": "dsh-memory MEM-101 embedding evaluation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dataset",
    "runner",
    "provider",
    "metrics",
    "buckets",
    "cases",
    "hardChecks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "referenceCommit"],
      "properties": {
        "id": { "const": "dsh-memory-embedding" },
        "version": { "const": "1.0.0" },
        "referenceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "repeats", "mode", "externalNetwork"],
      "properties": {
        "version": { "const": 1 },
        "repeats": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["offline-hash", "live"] },
        "externalNetwork": { "type": "boolean" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality", "model", "spaceId", "dimensions", "normalization"],
      "properties": {
        "quality": { "enum": ["portable-hash", "trained"] },
        "model": { "type": ["string", "null"] },
        "spaceId": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "integer", "minimum": 1 },
        "normalization": { "const": "l2" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synonym", "exact"],
      "properties": {
        "synonym": { "$ref": "#/$defs/metric" },
        "exact": { "$ref": "#/$defs/metric" }
      }
    },
    "buckets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/bucket" }
    },
    "cases": {
      "type": "array",
      "minItems": 26,
      "items": { "$ref": "#/$defs/case" }
    },
    "hardChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeLeaks", "forbiddenHits", "duplicateResultIds"],
      "properties": {
        "scopeLeaks": { "type": "integer", "minimum": 0 },
        "forbiddenHits": { "type": "integer", "minimum": 0 },
        "duplicateResultIds": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runner": {
            "properties": { "mode": { "const": "offline-hash" } },
            "required": ["mode"]
          }
        },
        "required": ["runner"]
      },
      "then": {
        "properties": {
          "runner": {
            "properties": { "externalNetwork": { "const": false } }
          },
          "provider": {
            "properties": {
              "quality": { "const": "portable-hash" },
              "model": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runner": {
            "properties": { "mode": { "const": "live" } },
            "required": ["mode"]
          }
        },
        "required": ["runner"]
      },
      "then": {
        "properties": {
          "runner": {
            "properties": { "externalNetwork": { "const": true } }
          },
          "provider": {
            "properties": {
              "quality": { "const": "trained" },
              "model": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recallAt5", "recallAt10", "mrrAt10"],
      "properties": {
        "recallAt5": { "$ref": "#/$defs/unit" },
        "recallAt10": { "$ref": "#/$defs/unit" },
        "mrrAt10": { "$ref": "#/$defs/unit" }
      }
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "language", "queryCount", "recallAt5", "recallAt10", "mrrAt10"],
      "properties": {
        "bucket": { "enum": ["synonym", "exact"] },
        "language": { "enum": ["zh", "en"] },
        "queryCount": { "type": "integer", "minimum": 1 },
        "recallAt5": { "$ref": "#/$defs/unit" },
        "recallAt10": { "$ref": "#/$defs/unit" },
        "mrrAt10": { "$ref": "#/$defs/unit" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "bucket",
        "split",
        "relevantIds",
        "forbiddenIds",
        "returnedIds",
        "firstRelevantRank",
        "recallAt5",
        "recallAt10",
        "reciprocalRank",
        "forbiddenHits"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "language": { "enum": ["zh", "en"] },
        "bucket": { "enum": ["synonym", "exact"] },
        "split": { "enum": ["baseline", "holdout"] },
        "relevantIds": { "$ref": "#/$defs/idArray" },
        "forbiddenIds": { "$ref": "#/$defs/idArray" },
        "returnedIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "firstRelevantRank": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 10 },
            { "type": "null" }
          ]
        },
        "recallAt5": { "$ref": "#/$defs/unit" },
        "recallAt10": { "$ref": "#/$defs/unit" },
        "reciprocalRank": { "$ref": "#/$defs/unit" },
        "forbiddenHits": { "$ref": "#/$defs/idArray" }
      }
    }
  }
}
